	issn = {0004-637X},
	shorttitle = {Characterizing the {Chemistry} of the {Milky} {Way} {Stellar} {Halo}},
	url = {https://ui.adsabs.harvard.edu/abs/2010ApJ...711..573R},
	doi = {10.1088/0004-637X/711/2/573},
	abstract = {We present the results of a detailed abundance analysis of one of the confirmed building blocks of the Milky Way stellar halo, a kinematically coherent metal-poor stellar stream. We have obtained high-resolution and high signal-to-noise spectra of 12 probable stream members using the Magellan Inamori Kyocera Echelle spectrograph on the Magellan-Clay Telescope at Las Campanas Observatory and the 2dCoude spectrograph on the Smith Telescope at McDonald Observatory. We have derived abundances or upper limits for 51 species of 46 elements in each of these stars. The stream members show a range of metallicity (-3.4 {\textless} [Fe/H] {\textless}-1.5) but are otherwise chemically homogeneous, with the same star-to-star dispersion in [X/Fe] as the rest of the halo. This implies that, in principle, a significant fraction of the Milky Way stellar halo could have formed from accreted systems like the stream. The stream stars show minimal evolution in the α or Fe-group elements over the range of metallicity. This stream is enriched with material produced by the main and weak components of the rapid neutron-capture process and shows no evidence for enrichment by the slow neutron-capture process. This paper includes data gathered with the 6.5 m Magellan Telescopes located at Las Campanas Observatory, Chile. This paper includes data taken at The McDonald Observatory of the University of Texas at Austin.},
	urldate = {2025-12-15},
	journal = {The Astrophysical Journal},
	author = {Roederer, Ian U. and Sneden, Christopher and Thompson, Ian B. and Preston, George W. and Shectman, Stephen A.},
	month = mar,
	year = {2010},
	note = {Publisher: IOP
ADS Bibcode: 2010ApJ...711..573R},
	keywords = {abundances, Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics, Galaxy: halo, Galaxy: kinematics and dynamics, nuclear reactions, nucleosynthesis, stars: abundances, stars: kinematics and dynamics, stars: Population II},
	pages = {573--596},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\A5EEUPBX\\Roederer et al. - 2010 - Characterizing the Chemistry of the Milky Way Stellar Halo Detailed Chemical Analysis of a Metal-po.pdf:application/pdf},
}

@article{norris_boo-1137extremely_2010-1,
	title = {Boo-1137—an {Extremely} {Metal}-{Poor} {Star} in the {Ultra}-{Faint} {Dwarf} {Spheroidal} {Galaxy} {Boötes} {I}},
	volume = {711},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2010ApJ...711..350N},
	doi = {10.1088/0004-637X/711/1/350},
	abstract = {We present high-resolution (R {\textasciitilde} 40,000), high-signal-to-noise ratio (20-90) spectra of an extremely metal-poor giant star Boo-1137 in the "ultra-faint" dwarf spheroidal galaxy (dSph) Boötes I, absolute magnitude M V {\textasciitilde} -6.3. We derive an iron abundance of [Fe/H] = -3.7, making this the most metal-poor star as yet identified in an ultra-faint dSph. Our derived effective temperature and gravity are consistent with its identification as a red giant in Boötes I. Abundances for a further 15 elements have also been determined. Comparison of the relative abundances, [X/Fe], with those of the extremely metal-poor red giants of the Galactic halo shows that Boo-1137 is "normal" with respect to C and N, the odd-Z elements Na and Al, the iron-peak elements, and the neutron-capture elements Sr and Ba, in comparison with the bulk of the Milky Way halo population having [Fe/H] lsim-3.0. The α-elements Mg, Si, Ca, and Ti are all higher by Δ[X/Fe] {\textasciitilde} 0.2 than the average halo values. Monte Carlo analysis indicates that Δ[α/Fe] values this large are expected with a probability {\textasciitilde}0.02. The elemental abundance pattern in Boo-1137 suggests inhomogeneous chemical evolution, consistent with the wide internal spread in iron abundances we previously reported. The similarity of most of the Boo-1137 relative abundances with respect to halo values, and the fact that the α-elements are all offset by a similar small amount from the halo averages, points to the same underlying galaxy-scale stellar initial mass function, but that Boo-1137 likely originated in a star-forming region where the abundances reflect either poor mixing of supernova (SN) ejecta, or poor sampling of the SN progenitor mass range, or both. Observations obtained for ESO program P383.B-0038, using VLT-UT2/UVES.},
	urldate = {2025-12-15},
	journal = {The Astrophysical Journal},
	author = {Norris, John E. and Yong, David and Gilmore, Gerard and Wyse, Rosemary F. G.},
	month = mar,
	year = {2010},
	note = {Publisher: IOP
ADS Bibcode: 2010ApJ...711..350N},
	keywords = {Astrophysics - Astrophysics of Galaxies, galaxies: abundances, galaxies: dwarf, galaxies: individual: Bootes I, Galaxy: abundances, stars: abundances},
	pages = {350--360},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\6DVQNA6K\\Norris et al. - 2010 - Boo-1137—an Extremely Metal-Poor Star in the Ultra-Faint Dwarf Spheroidal Galaxy Boötes I.pdf:application/pdf},
}

@article{ishigaki_chemical_2010,
	title = {Chemical {Abundances} of {Outer} {Halo} {Stars} in the {Milky} {Way}},
	volume = {62},
	issn = {0004-6264},
	url = {https://ui.adsabs.harvard.edu/abs/2010PASJ...62..143I},
	doi = {10.1093/pasj/62.1.143},
	abstract = {We present the chemical abundances of 57 metal-poor ([Fe/H] {\textless} -1) stars that are likely constituents of the outer stellar halo in the Milky Way. Almost all of the sample stars have an orbit reaching a maximum vertical distance (Zmax) of {\textgreater} 5 kpc above and below the Galactic plane. High-resolution (R ∼ 50000-55000), high signal-to-noise (S/N {\textgreater} 100) spectra for the sample stars obtained with Subaru/HDS were used to derive the chemical abundances of Na, Mg, Ca, Ti, Cr, Mn, Fe, Ni, Zn, Y, and Ba with an LTE abundance analysis code. The resulting abundance data were combined with those presented in the literature that mostly targeted at smaller Zmax stars, and both data were used to investigate any systematic trends in detailed abundance patterns depending on their kinematics. It was shown that, in the metallicity range of -2 {\textless} [Fe/H] {\textless} -1, the [Mg/Fe] ratios for stars with Zmax {\textgreater} 5 kpc are systematically lower (∼0.1 dex) than those with a smaller Zmax. For this metallicity range, a modest degree of depression in the [Si/Fe] and the [Ca/Fe] ratios was also observed. This result of lower [α/Fe] for the assumed outer halo stars is consistent with previous studies that found a signature of lower [α/Fe] ratios for stars with extreme kinematics. The distribution of the [Mg/Fe] ratios for the outer halo stars partly overlaps with that for stars belonging to the Milky Way dwarf satellites in the metallicity interval of -2 {\textless} [Fe/H] {\textless} -1 and spans a range intermediate between the distributions for the inner halo stars and the stars belonging to the satellites. Our results confirm the inhomogeneous nature of the chemical abundances within the Milky Way stellar halo, depending on the kinematic properties of the constituent stars, as suggested by earlier studies. Possible implications for the formation of the Milky Way halo and its relevance to the suggested dual nature of the halo are discussed.},
	urldate = {2025-12-15},
	journal = {Publications of the Astronomical Society of Japan},
	author = {Ishigaki, Miho and Chiba, Masashi and Aoki, Wako},
	month = feb,
	year = {2010},
	note = {Publisher: OUP
ADS Bibcode: 2010PASJ...62..143I},
	keywords = {Astrophysics - Astrophysics of Galaxies, Galaxy: abundances, Galaxy: halo, Galaxy: kinematics and dynamics},
	pages = {143},
	file = {Submitted Version:C\:\\Users\\rosym\\Zotero\\storage\\ASCP9JDY\\Ishigaki et al. - 2010 - Chemical Abundances of Outer Halo Stars in the Milky Way.pdf:application/pdf},
}

