	note = {Publisher: IOP
ADS Bibcode: 2002ApJ...573..614T},
	keywords = {Astrophysics, Galaxy: Abundances, Galaxy: Evolution, Stars: Abundances, Stars: Atmospheres, Stars: Population II},
	pages = {614--630},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\H2NVL64G\\Takada-Hidai et al. - 2002 - Behavior of Sulfur Abundances in Metal-poor Giants and Dwarfs.pdf:application/pdf},
