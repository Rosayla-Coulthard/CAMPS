@article{mardini_metal-poor_2019,
	title = {Metal-poor {Stars} {Observed} with the {Automated} {Planet} {Finder} {Telescope}. {II}. {Chemodynamical} {Analysis} of {Six} {Low}-metallicity {Stars} in the {Halo} {System} of the {Milky} {Way}},
