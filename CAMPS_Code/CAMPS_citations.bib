	note = {Publisher: EDP
ADS Bibcode: 2022A\&A...665A..10L},
	keywords = {Astrophysics - Astrophysics of Galaxies, Galaxy: abundances, Galaxy: evolution, nuclear reactions, nucleosynthesis, stars: abundances, stars: Population II, stars: Population III abundances},
	pages = {A10},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\W5YQQPBH\\Lombardo et al. - 2022 - Chemical Evolution of R-process Elements in Stars (CERES). I. Stellar parameters and chemical abunda.pdf:application/pdf},
}

@article{li_four-hundred_2022,
	title = {Four-hundred {Very} {Metal}-poor {Stars} {Studied} with {LAMOST} and {Subaru}. {II}. {Elemental} {Abundances}},
	volume = {931},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2022ApJ...931..147L},
	doi = {10.3847/1538-4357/ac6514},
	abstract = {We present homogeneous abundance analysis of over 20 elements for 385 very metal-poor (VMP) stars based on the LAMOST survey and follow-up observations with the Subaru Telescope. It is the largest high-resolution VMP sample (including 363 new objects) studied by a single program, and the first attempt to accurately determine evolutionary stages for such a large sample based on Gaia parallaxes. The sample covers a wide metallicity range from [Fe/H] ≲ -1.7 down to [Fe/H] {\textasciitilde} -4.3, including over 110 objects with [Fe/H] ≤ -3.0. The expanded coverage in evolutionary status makes it possible to define the abundance trends respectively for giants and turnoff stars. The newly obtained abundance data confirm most abundance trends found by previous studies, but also provide useful updates and new samples of outliers. The Li plateau is seen in main-sequence turnoff stars with -2.5 {\textless} [Fe/H] {\textless} -1.7 in our sample, whereas the average Li abundance is clearly lower at lower metallicity. Mg, Si, and Ca are overabundant with respect to Fe, showing decreasing trend with increasing metallicity. Comparisons with chemical evolution models indicate that the overabundance of Ti, Sc, and Co are not well reproduced by current theoretical predictions. Correlations are seen between Sc and α-elements, while Zn shows a detectable correlation only with Ti but not with other α-elements. The fraction of carbon-enhanced stars ([C/Fe] {\textgreater} 0.7) is in the range of 20\%-30\% for turnoff stars depending on the treatment of objects for which C abundance is not determined, which is much higher than that in giants ({\textasciitilde}8\%). Twelve Mg-poor stars ([Mg/Fe] {\textless} 0.0) have been identified in a wide metallicity range from [Fe/H] {\textasciitilde} -3.8 through -1.7. Twelve Eu-rich stars ([Eu/Fe] {\textgreater} 1.0) have been discovered in -3.4 {\textless} [Fe/H] {\textless} -2.0, enlarging the sample of r-process-enhanced stars with relatively high metallicity.},
	urldate = {2025-12-15},
	journal = {The Astrophysical Journal},
	author = {Li, Haining and Aoki, Wako and Matsuno, Tadafumi and Xing, Qianfan and Suda, Takuma and Tominaga, Nozomu and Chen, Yuqin and Honda, Satoshi and Ishigaki, Miho N. and Shi, Jianrong and Zhao, Jingkun and Zhao, Gang},
	month = jun,
	year = {2022},
	note = {Publisher: IOP
ADS Bibcode: 2022ApJ...931..147L},
	keywords = {1284, 224, 580, Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics, Chemical abundances, Galaxy chemical evolution, Population II stars},
	pages = {147},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\C4USCYJX\\Li et al. - 2022 - Four-hundred Very Metal-poor Stars Studied with LAMOST and Subaru. II. Elemental Abundances.pdf:application/pdf},
}

@article{theler_chemical_2020,
	title = {The chemical evolution of the dwarf spheroidal galaxy {Sextans}},
	volume = {642},
	issn = {0004-6361},
	url = {https://ui.adsabs.harvard.edu/abs/2020A&A...642A.176T},
	doi = {10.1051/0004-6361/201937146},
	abstract = {We present our analysis of the FLAMES dataset targeting the central 25' region of the Sextans dwarf spheroidal galaxy (dSph). This dataset is the third major part of the high-resolution spectroscopic section of the ESO large program 171.B-0588(A) obtained by the Dwarf galaxy Abundances and Radial-velocities Team. Our sample is composed of red giant branch stars down to V ∼ 20.5 mag, the level of the horizontal branch in Sextans, and allows users to address questions related to both stellar nucleosynthesis and galaxy evolution. We provide metallicities for 81 stars, which cover the wide [Fe/H] = -3.2 to -1.5 dex range. The abundances of ten other elements are derived: Mg, Ca, Ti, Sc, Cr, Mn, Co, Ni, Ba, and Eu. Despite its small mass, Sextans is a chemically evolved system, showing evidence of a contribution from core-collapse and Type Ia supernovae as well as low-metallicity asymptotic giant branch stars (AGBs). This new FLAMES sample offers a sufficiently large number of stars with chemical abundances derived with high accuracy to firmly establish the existence of a plateau in [α/Fe] at ∼0.4 dex followed by a decrease above [Fe/H] ∼ -2 dex. These features reveal a close similarity with the Fornax and Sculptor dSphs despite their very different masses and star formation histories, suggesting that these three galaxies had very similar star formation efficiencies in their early formation phases, probably driven by the early accretion of smaller galactic fragments, until the UV-background heating impacted them in different ways. The parallel between the Sculptor and Sextans dSph is also striking when considering Ba and Eu. The same chemical trends can be seen in the metallicity region common to both galaxies, implying similar fractions of SNeIa and low-metallicity AGBs. Finally, as to the iron-peak elements, the decline of [Co/Fe] and [Ni/Fe] above [Fe/H] ∼ -2 implies that the production yields of Ni and Co in SNeIa are lower than that of Fe. The decrease in [Ni/Fe] favours models of SNeIa based on the explosion of double-degenerate sub-Chandrasekhar mass white dwarfs. Tables 2-6, 9-13 are only available at the CDS via anonymous ftp to http://cdsarc.u-strasbg.fr (ftp://130.79.128.5) or via http://cdsarc.u-strasbg.fr/viz-bin/cat/J/A+A/642/A176 Based on the ESO Program 171.B-0588(A).},
	urldate = {2025-12-15},
	journal = {Astronomy and Astrophysics},
	author = {Theler, R. and Jablonka, P. and Lucchesi, R. and Lardo, C. and North, P. and Irwin, M. and Battaglia, G. and Hill, V. and Tolstoy, E. and Venn, K. and Helmi, A. and Kaufer, A. and Primas, F. and Shetrone, M.},
	month = oct,
	year = {2020},
	note = {Publisher: EDP
ADS Bibcode: 2020A\&A...642A.176T},
	keywords = {Astrophysics - Astrophysics of Galaxies, galaxies: dwarf, galaxies: evolution, stars: abundances},
	pages = {A176},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\8SX4EM7S\\Theler et al. - 2020 - The chemical evolution of the dwarf spheroidal galaxy Sextans.pdf:application/pdf},
}

@article{reichert_neutron-capture_2020,
