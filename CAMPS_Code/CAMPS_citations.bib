ADS Bibcode: 2010A\&A...509A..88A},
	keywords = {Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics, Galaxy: abundances, Galaxy: evolution, Galaxy: halo, stars: abundances, stars: evolution, supernovae: general},
	pages = {A88},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\ITMKYY8I\\Andrievsky et al. - 2010 - Non-LTE abundances of Mg and K in extremely metal-poor stars and the evolution of [OMg], [NaMg], [.pdf:application/pdf},
