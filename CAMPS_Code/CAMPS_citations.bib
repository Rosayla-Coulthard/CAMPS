	keywords = {Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics, Galaxy: abundances, Galaxy: formation, Galaxy: halo},
	pages = {56},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\E24XSXIM\\Cohen et al. - 2013 - Normal and Outlying Populations of the Milky Way Stellar Halo at [FeH] -2.pdf:application/pdf},
