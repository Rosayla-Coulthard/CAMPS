ADS Bibcode: 2002ApJ...576L.141A},
	keywords = {Abundances, Astrophysics, Nuclear Reactions, Nucleosynthesis, Stars: Abundances, Stars: Carbon, Stars: Individual: Alphanumeric: CS 29498-043, Stars: Population II},
	pages = {L141--L144},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\R55RSWFH\\Aoki et al. - 2002 - Chemical Composition of the Carbon-rich, Extremely Metal Poor Star CS 29498-043 A New Class of Extr.pdf:application/pdf},
