	volume = {556},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2001ApJ...556..858M},
	doi = {10.1086/321624},
	abstract = {Infrared OH lines at 1.55-1.56 μm in the H band were obtained with the Phoenix high-resolution spectrograph at the 2.1 m telescope of the Kitt Peak National Observatory for a sample of 14 metal-poor stars. Detailed analyses of the sample stars have been carried out, deriving stellar parameters based on two methods: (a) spectroscopic parameters and (b) infrared flux method (IRFM) effective temperatures, trigonometric gravities, and metallicities from Fe II lines. The Fe I lines present in the H-band region observed were well fitted by the stellar parameters within Δ[Fe/H]{\textless}=0.15 dex. The oxygen abundances were derived from fits of spectrum synthesis calculations to the infrared OH lines. CO lines in the H and K bands were obtained for a subsample in order to determine their carbon abundances. Adopting the spectroscopic parameters, a mean oxygen-to-iron ratio of [O/Fe]{\textasciitilde}0.52 is obtained, whereas using the IRFM temperatures, Hipparcos gravities, and [Fe II/H], [O/Fe]{\textasciitilde}0.25 is found. A mean of the two methods gives a final value of [O/Fe]{\textasciitilde}0.4 for the metallicity range -2.2{\textless}[Fe/H]{\textless}-1.2 of the sample metal-poor stars.},
	urldate = {2025-12-15},
	journal = {The Astrophysical Journal},
	author = {Meléndez, Jorge and Barbuy, Beatriz and Spite, François},
	month = aug,
	year = {2001},
	note = {Publisher: IOP
ADS Bibcode: 2001ApJ...556..858M},
	keywords = {Astrophysics, Infrared: Stars, Stars: Abundances, Stars: Late-Type, Stars: Population II},
	pages = {858--871},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\RJLZZYH8\\Meléndez et al. - 2001 - Oxygen Abundances in Metal-poor Stars (-2.2[FeH]-1.2) from Infrared OH Lines.pdf:application/pdf},
}

@article{cayrel_determination_2001,
	title = {Determination of [{O}/{Fe}] in {BD} +23 3130 from {ESO} {VLT}-{UVES} observations},
