@article{melendez_keck_2002,
	title = {Keck {NIRSPEC} {Infrared} {OH} {Lines}: {Oxygen} {Abundances} in {Metal}-poor {Stars} down to [{Fe}/{H}] = -2.9},
	volume = {575},
