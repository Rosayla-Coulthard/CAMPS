ADS Bibcode: 2012A\&A...541A..48L},
	keywords = {abundances, Astrophysics - Solar and Stellar Astrophysics, nuclear reactions, nucleosynthesis, stars: abundances, stars: atmospheres, stars: chemically peculiar},
	pages = {A48},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\74HNSEFY\\Liu et al. - 2012 - Abundances of neutron-capture elements in G 24-25. A halo-population CH subgiant.pdf:application/pdf},
