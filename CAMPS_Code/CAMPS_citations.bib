	keywords = {Abundances, Astrophysics, Galaxy: Evolution, Nuclear Reactions, Nucleosynthesis, Stars: Abundances, Stars: Late-Type, Stars: Population II},
	pages = {L43--L46},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\5VW57IRP\\Israelian and Rebolo - 2001 - Sulphur Abundance in Very Metal-poor Stars.pdf:application/pdf},
}

@article{melendez_oxygen_2001,
