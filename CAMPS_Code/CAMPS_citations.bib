}

@misc{primas_first_2000,
	title = {First {UVES} observations of beryllium in very metal-poor stars},
	url = {https://ui.adsabs.harvard.edu/abs/2000A&A...362..666P},
	doi = {10.48550/arXiv.astro-ph/0008402},
	abstract = {We report on a attempt to detect beryllium in two dwarf stars of the Galactic halo with metallicities below one thousandth solar. The data were obtained during the Commissioning of the Ultraviolet and Visible Echelle Spectrograph (UVES) mounted on the ESO VLT Kueyen telescope, and show the potential of UVES for studies in the UV-optical domain. We claim a beryllium detection in LP 815-43 ([Fe/H] {\textasciitilde} -2.95, [Be/H] = -13.09) at the 99.7\% confidence level, while only an upper limit can be set for the second target CD-24o17504 ([Fe/H] {\textasciitilde} -3.30, [Be/H] {\textless}= -13.39). These results suggest that the trend of beryllium with metallicity keeps decreasing as lower metallicities are probed, with no evidence for flattening. In CD-24o17504 we also analyzed the Li I line at 6708 Å, and derived a lithium abundance close to the Spite plateau. Based on public data released from the UVES Commissioning at the VLT/Kueyen telescope, European Southern Observatory, Paranal, Chile},
	urldate = {2025-12-15},
	publisher = {arXiv},
	author = {Primas, F. and Molaro, P. and Bonifacio, P. and Hill, V.},
	month = oct,
