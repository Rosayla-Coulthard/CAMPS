	author = {Placco, Vinicius M. and Beers, Timothy C. and Ivans, Inese I. and Filler, Dan and Imig, Julie A. and Roederer, Ian U. and Abate, Carlo and Hansen, Terese and Cowan, John J. and Frebel, Anna and Lawler, James E. and Schatz, Hendrik and Sneden, Christopher and Sobeck, Jennifer S. and Aoki, Wako and Smith, Verne V. and Bolte, Michael},
	month = oct,
