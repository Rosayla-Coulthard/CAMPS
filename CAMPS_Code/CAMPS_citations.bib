	note = {Publisher: OUP
ADS Bibcode: 2017MNRAS.466.3741V},
	keywords = {Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics, galaxies: dwarf, galaxies: individual: Triangulum II, stars: abundances},
	pages = {3741--3752},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\L89C79R8\\Venn et al. - 2017 - GeminiGRACES spectroscopy of stars in Tri II.pdf:application/pdf},
