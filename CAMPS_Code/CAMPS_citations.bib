ADS Bibcode: 2015ApJ...806L..16B},
	keywords = {Astrophysics - Solar and Stellar Astrophysics, stars: Population III, supernovae: general, supernovae: individual: SMSS J031300.36},
	pages = {L16},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\NAUH8DPE\\Bessell et al. - 2015 - Nucleosynthesis in a Primordial Supernova Carbon and Oxygen Abundances in SMSS J031300.36-670839.3.pdf:application/pdf},
