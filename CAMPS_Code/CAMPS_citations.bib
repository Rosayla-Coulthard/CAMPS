}

@article{johnson_th_2001,
	title = {Th {Ages} for {Metal}-poor {Stars}},
	volume = {554},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2001ApJ...554..888J},
	doi = {10.1086/321386},
	abstract = {With a sample of 22 metal-poor stars, we demonstrate that the heavy-element abundance pattern (Z{\textgreater}=56) is the same as the r-process contributions to the solar nebula. This bolsters the results of previous studies that there is a universal r-process production pattern. We use the abundance of thorium in five metal-poor stars, along with an estimate of the initial Th abundance based on the abundances of stable r-process elements, to measure their ages. We have four field red giants with errors of 4.2 Gyr in their ages and one M92 giant with an error of 5.6 Gyr, based on considering the sources of observational error only. We obtain an average age of 11.4 Gyr, which depends critically on the assumption of an initial Th/Eu production ratio of 0.496. If the universe is 15 Gyr old, then the (Th/Eu)0 should be 0.590, in agreement with some theoretical models of the r-process.},
	urldate = {2025-12-15},
	journal = {The Astrophysical Journal},
	author = {Johnson, Jennifer A. and Bolte, Michael},
	month = jun,
	year = {2001},
	note = {Publisher: IOP
ADS Bibcode: 2001ApJ...554..888J},
	keywords = {Abundances, Astrophysics, Cosmology: Observations, Galaxy: Abundances, Nuclear Reactions, Nucleosynthesis, Stars: Abundances, Stars: Population II},
	pages = {888--902},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\MHIYPENI\\Johnson and Bolte - 2001 - Th Ages for Metal-poor Stars.pdf:application/pdf},
}

@article{giridhar_chemical_2001,
	title = {Chemical {Compositions} of {Four} {Metal}-poor {Giant} {Stars}},
	volume = {113},
	issn = {0004-6280},
	url = {https://ui.adsabs.harvard.edu/abs/2001PASP..113..519G},
	doi = {10.1086/320291},
	abstract = {We present the chemical compositions of four K giants (CS 22877-1, CS 22166-16, CS 22169-35, and BS 16085-0050) that have [Fe/H] in the range -2.4 to -3.1. Metal-poor stars with [Fe/H]{\textless}-2.5 are known to exhibit considerable star-to-star variations of many elements. This quartet confirms this conclusion. CS 22877-1 and CS 22166-16 are carbon-rich. There is significant spread of [α/Fe] within our samples, where [α/Fe] is computed from the mean of the [Mg/Fe] and [Ca/Fe] ratios. BS 16085-0050 is remarkably α-enriched with a mean [α/Fe] of +0.7, but CS 22169-35 is α-poor. The aluminum abundance also shows a significant variation over the sample. A parallel and unsuccessful search among high-velocity late-type stars for metal-poor stars is described.},
