	note = {Publisher: IOP
ADS Bibcode: 2009ApJ...697L..63L},
	keywords = {Astrophysics - Galaxy Astrophysics, Astrophysics - Solar and Stellar Astrophysics, Galaxy: halo, stars: abundances, stars: Population II, supernovae: general},
	pages = {L63--L67},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\UR6WGIYA\\Lai et al. - 2009 - A Unique Star in the Outer Halo of the Milky Way.pdf:application/pdf},
