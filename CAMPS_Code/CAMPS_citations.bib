	title = {Non-{LTE} abundances of {Mg} and {K} in extremely metal-poor stars and the evolution of [{O}/{Mg}], [{Na}/{Mg}], [{Al}/{Mg}], and [{K}/{Mg}] in the {Milky} {Way}},
