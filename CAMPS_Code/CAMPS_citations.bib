	month = may,
	year = {2004},
	note = {Publisher: IOP
ADS Bibcode: 2004ApJS..152..113H},
	keywords = {Abundances, Astrophysics, Nuclear Reactions, Nucleosynthesis, Stars: Abundances, Stars: Population II},
	pages = {113--128},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\SHJDZ37B\\Honda et al. - 2004 - Spectroscopic Studies of Extremely Metal-Poor Stars with the Subaru High Dispersion Spectrograph. I..pdf:application/pdf},
