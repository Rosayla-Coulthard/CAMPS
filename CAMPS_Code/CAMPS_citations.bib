	note = {Publisher: IOP
ADS Bibcode: 2007ApJ...660L.117F},
	keywords = {Abundances, Astrophysics, Cosmology: Early Universe, Galaxy: Halo, Nuclear Reactions, Nucleosynthesis, Stars: Abundances, stars: individual (HE 1523-0901)},
	pages = {L117--L120},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\YHMAZQZ2\\Frebel et al. - 2007 - Discovery of HE 1523-0901, a Strongly r-Process-enhanced Metal-poor Star with Detected Uranium.pdf:application/pdf},
}

