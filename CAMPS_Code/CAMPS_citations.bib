	keywords = {STARS: ABUNDANCES, STARS: AGB AND POST-AGB, STARS: CHEMICALLY PECULIAR, STARS: EVOLUTION, STARS: INDIVIDUAL: HD 196944},
	pages = {216--222},
}

@article{shetrone_keck_1998,
	title = {Keck {HIRES} {Abundances} in the {Dwarf} {Spheroidal} {Galaxy} {Draco}},
	volume = {115},
	issn = {0004-6256},
	url = {https://ui.adsabs.harvard.edu/abs/1998AJ....115.1888S},
	doi = {10.1086/300341},
	abstract = {An analysis of high-resolution Keck HIRES spectra of four giants in the dwarf spheroidal galaxy Draco is presented. We find an unmistakable difference in [Fe/H] among the four stars analyzed, with the range -3.0 {\textless} [Fe/H] {\textless} -1.5. The abundance ratios are found to be consistent with a Population II sample, although the [Ca/Fe] ratio may be more nearly solar and the [Ba/Fe] ratio exhibits a steeper slope with [Fe/H] than has been found in the Galactic globular clusters or in the Galactic halo field stars. A hint of a deep-mixing pattern is found in one star (D473), suggesting that Draco giants may be more similar to globular cluster giants than they are to the field Population II giants.},
	urldate = {2025-12-15},
	journal = {The Astronomical Journal},
	author = {Shetrone, Matthew D. and Bolte, Michael and Stetson, Peter B.},
	month = may,
	year = {1998},
