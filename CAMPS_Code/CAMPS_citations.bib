	note = {Publisher: IOP
ADS Bibcode: 2019ApJ...870..122P},
	keywords = {Astrophysics - Solar and Stellar Astrophysics, Galaxy: halo, stars: abundances, stars: atmospheres, stars: carbon, stars: Population II, techniques: spectroscopic},
