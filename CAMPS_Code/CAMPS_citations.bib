	keywords = {GALAXIES: ABUNDANCES, GALAXIES: DWARF, STARS: ABUNDANCES},
	pages = {1888--1893},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\YVJ8D5NM\\Shetrone et al. - 1998 - Keck HIRES Abundances in the Dwarf Spheroidal Galaxy Draco.pdf:application/pdf},
}

@article{sneden_hubble_1998,
	title = {Hubble {Space} {Telescope} {Observations} of {Neutron}-{Capture} {Elements} in {Very} {Metal} {Poor} {Stars}},
	volume = {496},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/1998ApJ...496..235S},
	doi = {10.1086/305366},
	abstract = {Using the Goddard High-Resolution Spectrograph (GHRS) of the Hubble Space Telescope (HST) we have detected the neutron-capture elements osmium, platinum, and lead in the very metal poor ([Fe/H] {\textasciitilde}= -2.8) Galactic halo star HD 115444. This star joins the metal-poor giant HD 126238 ([Fe/H] {\textasciitilde}= -1.7) as the second Galactic halo star for which ``third neutron-capture peak'' elements have been detected. We have also determined upper limits on these same elements for the neutron-capture deficient star HD 122563 ([Fe/H] {\textasciitilde}= - 2.7). We have identified zirconium and germanium features in the HST spectra of all three stars; this marks the initial identification of the latter element in halo stars. We compare and contrast the spectra and abundances of the neutron-capture elements in these three stars. Combining the new HST observations of the third neutron-capture peak elements of HD 115444 with ground-based data, we find the stellar abundance distribution, over a wider atomic number range than ever before possible, is consistent with the solar system r-process abundance curve. Comparison of this star to the more metal-rich HD 126238 finds that the ratio of the third-peak element abundances to that of the pure r-process element europium is the same in both stars. Earlier ground-based studies have found that abundances of the lighter elements, such as barium and europium, in HD 115444 exceed those of HD 122563 by {\textasciitilde}0.7 dex. Our osmium, platinum, and lead upper limits show a similar difference and are not inconsistent with either the scaled solar r-process or the solar total distribution. Thus, the second and third neutron-capture peak element (Z {\textgreater}= 56) abundances in all three stars are consistent with scaled solar system r-process abundances. However, the zirconium abundance is approximately the same in HD 122563 and HD 115444, so this element (near the first neutron-capture peak) is overabundant (somewhat) in HD 122563 and (slightly) in HD 115444 with respect to the solar r-process abundances. Germanium (synthesized in approximately equal amounts by the r- and the s-process in solar material) is underabundant in all three stars, but does seem to scale with metallicity--it is identical in HD 115444 and HD 126238, but significantly greater in the higher metallicity HD 126238. These new results support previous observations that demonstrate the operation of the r-process, including the synthesis of the heaviest such elements, early in the history of the Galaxy. Implications of these results for early Galactic chemical evolution are discussed.},
	urldate = {2025-12-15},
	journal = {The Astrophysical Journal},
	author = {Sneden, Christopher and Cowan, John J. and Burris, Debra L. and Truran, James W.},
	month = mar,
	year = {1998},
	note = {Publisher: IOP
ADS Bibcode: 1998ApJ...496..235S},
	keywords = {Abundances, ABUNDANCES, Galaxy: Evolution, GALAXY: EVOLUTION, Nuclear Reactions, NUCLEAR REACTIONS, Nucleosynthesis, NUCLEOSYNTHESIS, Stars: Abundances, STARS: ABUNDANCES, STARS: INDIVIDUAL HENRY DRAPER NUMBER: HD 115444, STARS: INDIVIDUAL HENRY DRAPER NUMBER: HD 125268, STARS: INDIVIDUAL HENRY DRAPER NUMBER: HD 126238, Stars: Individual: Henry Draper Number: HD 115444, Stars: Individual: Henry Draper Number: HD 125268, Stars: Individual: Henry Draper Number: HD 126238, Stars: Population II, STARS: POPULATION II},
	pages = {235--245},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\32TRF6FX\\Sneden et al. - 1998 - Hubble Space Telescope Observations of Neutron-Capture Elements in Very Metal Poor Stars.pdf:application/pdf},
}

@article{norris_extremely_1997,
	title = {Extremely {Metal}-poor {Stars}. {The} {Carbon}-rich, {Neutron} {Capture} {Element}--poor {Object} {CS} 22957-027},
	volume = {489},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/1997ApJ...489L.169N},
	doi = {10.1086/316787},
	abstract = {Analysis of high-resolution spectra of the carbon-rich, metal-poor giant CS 22957-027 yields [Fe/H] = -3.38, [C/Fe] = 2.2, 12C/13C = 10, [N/Fe] = 2.0, [Sr/Fe] = -0.6, and [Ba/Fe] = -1.0. This combination of large C and N overabundances and the absence of heavy neutron capture element enrichment differs from that normally found in C-rich metal-poor stars, which are all usually enhanced in these elements. Any explanation in terms of the canonical binary mass transfer origin of CH stars or of supernovae ejecta requires a decoupling of the processes that produce the C and neutron capture element overabundances. An alternative possibility is that the heavy element abundances are typical of the halo interstellar medium from which CS 22957-027 formed and the C and N overabundances result from processes internal to the star itself. One candidate process is helium core flash induced mixing in low-mass, zero heavy element stars as predicted by Hollowell et al. CS 22957-027 exhibits strong features of 13CH at {\textasciitilde}4019.0 A, which coincide with Th II 4019.12 A. This should be borne in mind when using the Th/Eu ratio in metal-poor, C-rich stars such as CS 22892-052 as a Galactic chronometer.},
	urldate = {2025-12-15},
	journal = {The Astrophysical Journal},
	author = {Norris, John E. and Ryan, Sean G. and Beers, Timothy C.},
	month = nov,
	year = {1997},
	note = {Publisher: IOP
ADS Bibcode: 1997ApJ...489L.169N},
	keywords = {ABUNDANCES, GALAXY: ABUNDANCES, NUCLEAR REACTIONS, NUCLEOSYNTHESIS, STARS: ABUNDANCES, STARS: CARBON, STARS: POPULATION II},
	pages = {L169},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\DXPVY3MX\\Norris et al. - 1997 - Extremely Metal-poor Stars. The Carbon-rich, Neutron Capture Element--poor Object CS 22957-027.pdf:application/pdf},
