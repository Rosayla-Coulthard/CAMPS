ADS Bibcode: 2015A\&A...580A..18F},
	keywords = {Astrophysics - Astrophysics of Galaxies, galaxies: dwarf, galaxies: individual: Carina, galaxies: stellar content, stars: abundances, stars: fundamental parameters},
	pages = {A18},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\KX8SIVQP\\Fabrizio et al. - 2015 - The Carina Project. VIII. The α-element abundances.pdf:application/pdf},
}

