	note = {Publisher: EDP
ADS Bibcode: 2002A\&A...393..617F},
	keywords = {Astrophysics, stars: abundances, stars: interiors, stars: Population II},
	pages = {617--628},
	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\HU2ARJMV\\Ford et al. - 2002 - Lithium 6104 Å in Population II stars.pdf:application/pdf},
}

@article{aoki_chemical_2002,
	title = {Chemical {Composition} of the {Carbon}-rich, {Extremely} {Metal} {Poor} {Star} {CS} 29498-043: {A} {New} {Class} of {Extremely} {Metal} {Poor} {Stars} with {Excesses} of {Magnesium} and {Silicon}},
