	file = {Full Text PDF:C\:\\Users\\rosym\\Zotero\\storage\\K33TRSIF\\Meléndez and Cohen - 2007 - Magnesium Isotopes in Metal-poor Dwarfs The Rise of AGB Stars and the Formation Timescale of the Ga.pdf:application/pdf},
