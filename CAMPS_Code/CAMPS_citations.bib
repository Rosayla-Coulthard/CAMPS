	keywords = {astronomical data bases: miscellaneous, Astrophysics, stars: abundances, stars: evolution},
	pages = {1159},
	file = {Submitted Version:C\:\\Users\\rosym\\Zotero\\storage\\4C3UZLQR\\Suda et al. - 2008 - Stellar Abundances for the Galactic Archeology (SAGA) Database --- Compilation of the Characteristic.pdf:application/pdf},
}

@article{suda_stellar_2011,
